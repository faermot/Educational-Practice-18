<Page
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av" x:Class="WpfApp20.Pages.TasksPage"
      Title="TasksPage"
      av:DesignHeight="370" av:DesignWidth="600"
      >
    <Grid Margin="10,10,10,10">
        <TextBlock x:Name="TaskNumberTextBlock" 
               FontSize="23" 
               FontWeight="Bold" 
               Margin="10,8,0,0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top" Width="184"/>

        <StackPanel Margin="10,56,10,107">
            <TextBlock Text="Введите строку: "/>
            <TextBox x:Name="InputLine" />
        </StackPanel>

        <!-- Кнопка расчёта -->
        <Button Content="Рассчитать"
                HorizontalAlignment="Center"
                Margin="0,300,0,10" 
                Padding="10" 
                Width="560"
                Height="40"
                Click="CalculateButton_Click" />

        <!-- Поле для вывода результата -->
        <TextBlock x:Name="ResultTextBlock" 
                   VerticalAlignment="Center"
                   FontSize="18" 
                   FontWeight="Bold" 
                   Foreground="Green" Margin="10,246,10,50" />
    </Grid>
</Page>